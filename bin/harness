#!/bin/bash
# harness — The global CLI entry point for Harness Meta-Framework (Supports both Interactive & Flag modes)

set -e

HARNESS_DIR="${HARNESS_DIR:-$HOME/harness}"
if [ ! -d "$HARNESS_DIR" ]; then
    if [ -f "PRD/core-principles.md" ]; then
        HARNESS_DIR="$(pwd)"
    else
        echo "[ERROR] Cannot find Harness repository."
        exit 1
    fi
fi
HARNESS_DIR="$(cd "$HARNESS_DIR" && pwd)"
export HARNESS_DIR

# --- Functions ---
launch_nightshift() {
    local lane="$1"
    local directions="$2"
    local script="$HARNESS_DIR/codex-skill/nightshift/scripts/nightshift-launch.sh"
    [ "$lane" = "philosophy" ] && script="$HARNESS_DIR/codex-skill/nightshift-phi/scripts/nightshift-phi-launch.sh"
    "$script" "$directions"
}

launch_sleep() {
    local lane="$1"
    export SLEEP_MAX_MINUTES=45
    export SLEEP_ENABLE_WATCHDOG=0
    "$HARNESS_DIR/codex-skill/nightshift-sleep/scripts/nightshift-sleep-launch.sh" "$lane"
}

# --- Arg Parsing ---
MODE=""
LANE="engineering"
DIRECTIONS=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --mode) MODE="$2"; shift 2 ;;
        --lane) LANE="$2"; shift 2 ;;
        --focus) DIRECTIONS="$2"; shift 2 ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

# --- Interactive Mode (if no mode provided) ---
if [ -z "$MODE" ]; then
    echo "================================================="
    echo "   Harness Environment Compiler & Nightshift     "
    echo "================================================="
    echo "1) Nightshift (Explore)"
    echo "2) Sleep (Compile)"
    echo "3) Closed-loop (Auto-evolution)"
    read -p "Option [1-3]: " mode_idx
    [ "$mode_idx" = "1" ] && MODE="nightshift"
    [ "$mode_idx" = "2" ] && MODE="sleep"
    [ "$mode_idx" = "3" ] && MODE="loop"
    
    echo "Lanes: 1) engineering 2) philosophy 3) both"
    read -p "Lane [1-3]: " lane_idx
    [ "$lane_idx" = "1" ] && LANE="engineering"
    [ "$lane_idx" = "2" ] && LANE="philosophy"
    [ "$lane_idx" = "3" ] && LANE="both"

    if [[ "$MODE" == "nightshift" || "$MODE" == "loop" ]]; then
        read -p "Focus directions: " DIRECTIONS
    fi
fi

# --- Execution ---
case "$MODE" in
    nightshift)
        [ "$LANE" = "both" ] && { launch_nightshift "engineering" "$DIRECTIONS"; launch_nightshift "philosophy" "$DIRECTIONS"; } || launch_nightshift "$LANE" "$DIRECTIONS"
        ;;
    sleep)
        [ "$LANE" = "both" ] && { launch_sleep "engineering"; launch_sleep "philosophy"; } || launch_sleep "$LANE"
        ;;
    loop)
        echo "[Harness] Launching closed-loop..."
        if [ "$LANE" = "both" ]; then
            launch_nightshift "engineering" "$DIRECTIONS"
            launch_nightshift "philosophy" "$DIRECTIONS"
            sleep 5
            launch_sleep "engineering"
            launch_sleep "philosophy"
            tmux new-session -d -s "harness-sync-daemon" "RESTART_AFTER_SYNC=1 $HARNESS_DIR/codex-skill/scripts/wait-sleep-and-reconcile.sh both"
        else
            launch_nightshift "$LANE" "$DIRECTIONS"
            sleep 5
            launch_sleep "$LANE"
            tmux new-session -d -s "harness-sync-daemon" "RESTART_AFTER_SYNC=1 $HARNESS_DIR/codex-skill/scripts/wait-sleep-and-reconcile.sh $LANE"
        fi
        ;;
esac
echo "✅ Operation $MODE launched on lane $LANE."
